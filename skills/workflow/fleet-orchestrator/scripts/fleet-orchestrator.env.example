# Copy to a path of your choosing, fill it in, and export FLEET_ENV=<that path>
# before running any fleet-orchestrator script. Values are plain shell
# assignments; the loader exports them for you.

# Required.
FLEET_SESSION=my-fleet
FLEET_SEED=/abs/path/to/seed-repo

# Defaults: <seed>/temp/fleet/fleet.json and its neighboring runtime files.
# The seed repository must ignore /temp/. Override only when needed.
# FLEET_STATE_DIR=/abs/path/to/gitignored/fleet-state
# FLEET_CONFIG=/abs/path/to/fleet.json

# Optional: the coordinator lane that receives routine settle events.
# FLEET_COORDINATOR=coordinator

# Optional: legacy lane-name routing used only when an agent record has no
# role. Current review records wake the orchestrator by role.
# FLEET_VERDICT_LANE_GLOBS='*-review* *-rereview* *-parity*'

# Optional: an external board adapter's projection. No board is created or
# required; set this only to enable the BOARD-STALE check for that projection.
# FLEET_BOARD=/abs/path/to/board-file

# Optional: shift deadline for the countdown line, local time.
# FLEET_DEADLINE='2026-12-31 23:59'

# Optional: workflow to trigger once when a push produces no CI run at all.
# FLEET_CI_RETRIGGER_WORKFLOW=deploy.yml
# FLEET_CI_RETRIGGER_REF=main

# Optional: cadence and thresholds, all in seconds.
# FLEET_POLL_SECONDS=10
# FLEET_ACK_TIMEOUT_SECONDS=120
# FLEET_TEARDOWN_GRACE_SECONDS=30
# FLEET_STALL_SECONDS=2700
# FLEET_CI_POLLS=40
# FLEET_CI_POLL_SECONDS=90
# FLEET_MONITOR_STALE_SECONDS=30
# FLEET_CI_STALE_SECONDS=240
# FLEET_BOARD_STALE_SECONDS=600
# FLEET_VELOCITY_WINDOW_SECONDS=3300

# Optional: phase vocabulary of your fleet config, matched on the stem so
# review-2 and bounce-1 count as review and bounce.
# FLEET_CLOSED_PHASES='landed superseded withdrawn complete'
# FLEET_QUEUED_PHASES='approved approved-replay-queued landing-replay'
# FLEET_ACTIVE_PHASES='implementing review in-review bounce'
# FLEET_BLOCKED_PHASES='blocked parked hold'
