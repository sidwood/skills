// The fleet's model presets (Sid, 2026-11-10), for every writer that one
// Opus 5.5 xhigh reviewer checks. No OpenAI model: that subscription has
// lapsed. references/model-tiers.md has the whole table, the Cursor pairs
// and QA included.
//   simple:   Sonnet 5.5 xhigh writes           -> one Opus 5.5 xhigh reviewer
//   standard: GLM 5.3 max or Grok 4.7 xhigh     -> one Opus 5.5 xhigh reviewer
//   complex:  Fable 5.2 xhigh writes            -> one Opus 5.5 xhigh reviewer
// When Opus writes, use policy-presets-opus-writer.jsonc instead.
// Copy this file into the project (.atomic/fleet/) and pass its absolute
// path to every launch with the tier and that tier's writer:
//   launch.sh --policy <abs path> --tier simple   --writer anthropic/claude-sonnet-5-5:xhigh
//   launch.sh --policy <abs path> --tier standard --writer zai/glm-5.3:max
//   launch.sh --policy <abs path> --tier standard --writer xai/grok-4.7:xhigh
//   launch.sh --policy <abs path> --tier complex  --writer anthropic/claude-fable-5-2:xhigh
// The atomic-work profile uses this file for its simple tier: add
// --agent-dir ~/.atomic-work/agent.
// A --policy passed with --checkout must be an absolute path.
//
// Precedence, highest first: a top-level model key in this file (an
// override for every run that reads it), the launch inputs, the chosen
// review tier, then defaults. The file is read again before every turn.
{
  "defaults": {
    "orchestrator_model": "anthropic/claude-sonnet-5-5:medium",
    // Findings are re-verified on the reviewer's line, which never writes
    // under this file.
    "reverify_model": "anthropic/claude-opus-5-5:high",
    "review_tier": "standard"
  },
  "review_tiers": {
    // One reviewer in every tier, never on the writer's model line.
    "simple": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    },
    "standard": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    },
    "complex": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    }
  },
  // When a writer's provider fails the run moves the writer to the next model
  // listed for its model line; a model on the tier's panel, or re-verifying
  // its findings, is passed over. With nothing left the run stops and can be
  // resumed. The GLM and Grok chains are Sid's order of 2026-11-06. Sid has
  // named no fallback for an Anthropic writer; the empty keys stop a run
  // inheriting a chain from the shared policy.
  "writer_fallbacks": {
    "zai/glm-5.3": ["xai/grok-4.7:xhigh", "anthropic/claude-sonnet-5-5:xhigh"],
    "xai/grok-4.7": ["anthropic/claude-sonnet-5-5:xhigh"],
    "anthropic/claude-sonnet-5-5": [],
    "anthropic/claude-fable-5-2": []
  }
}
